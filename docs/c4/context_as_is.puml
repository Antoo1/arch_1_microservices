@startuml context_as_is
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title C4 Context (As-Is) — «Тёплый дом», монолит

Person(user, "Пользователь", "Владелец дома. Смотрит температуру через веб-интерфейс")
Person(specialist, "Специалист по подключению", "Выезжает и подключает датчики/реле к системе")

System(monolith, "Smart Home (монолит на Go)", "Обработка запросов, бизнес-логика, работа с данными в одном приложении")

System_Ext(sensor, "Датчик температуры / реле", "Установлен в доме. Отдаёт температуру по запросу сервера (pull)")

Rel(user, monolith, "Смотрит температуру, управляет сенсорами", "HTTP/JSON, синхронно")
Rel(specialist, sensor, "Устанавливает и подключает", "Ручной выезд")
Rel(monolith, sensor, "Опрашивает температуру", "HTTP, синхронно, pull")

note right of monolith
  Управление отоплением в коде НЕ реализовано
  (есть только тип устройства "temperature").
end note

@enduml
